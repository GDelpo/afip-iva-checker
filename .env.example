# Credenciales del API AFIP (usa afip-services-api como backend)
AFIP_USERNAME=your-api-username
AFIP_PASSWORD=your-api-password
AFIP_BASE_URL=http://localhost:8000

# Control de chunking y rate limiting
AFIP_CHUNK_SIZE=100
AFIP_MAX_CALLS=50
AFIP_PAUSE_DURATION=30
AFIP_MAX_RETRIES=3
AFIP_RETRY_DELAY=2

# Lista de servicios AFIP disponibles separados por coma
AFIP_SERVICES_AVAILABLE=inscription,padron
